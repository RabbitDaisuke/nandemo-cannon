; Godot 4.7.2. Web / Compatibility / single thread.
config_version=5

[application]
config/name="なんでもキャノン"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/objects/refrigerator.svg"
boot_splash/bg_color=Color(0.07, 0.13, 0.19, 1)

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=6

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
2d/default_gravity=980.0
2d/default_linear_damp=0.12
2d/default_angular_damp=0.3
2d/solver/solver_iterations=16

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.13, 0.19, 1)
textures/vram_compression/import_etc2_astc=false

[audio]
general/default_playback_type.web=1

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/inference_on_variant=0
