      "holdSeconds": 0.4,
      "resetWhenBelowRatio": 0.8,
      "oneShotTransition": true,
      "shardsMax": 8,
      "shardsLifetimeSeconds": 0.35,
      "shardsHaveCollision": false,
      "shardsScore": 0
    },
    "fire": {
      "visualFps": 12,
      "contactIntervalSeconds": 0.1,
      "heatSeconds": 4,
      "wetIgnitionDelaySeconds": 2,
      "destruction": "burn fuel reaches zero, spawn non-scoring ash, remove original collider",
      "stops": "water or cold reduces heat to zero; consumed fuel is not restored"
    },
    "flamethrower": {
      "lifetimeTicks": 720,
      "pauseAware": true,
      "jetLocalTransform": true,
      "collision": "occlude heat ray at solid geometry before testing flammable target"
    },
    "explosion": {
      "probability": "clamp(strength*(1-resistance)*(1-distance/radius),0,1)",
      "random": "seeded once per explosionId/objectId pair; not once per frame",
      "resistanceRange": [
        0,
        1
      ],
      "resistanceOne": "never breaks from explosion",
      "impulse": "radial with distance attenuation regardless of break result"
    },
    "liquid": {
      "tileSize": 16,
      "stepHz": 20,
      "source": "bounded spawn budget with level volume limit",
      "flow": "volume flux to free neighbor cells; flow tile has vector",
      "solidMask": "all occupied colliders including every umbrella fixture",
      "sourceVolumeCap": 256,
      "maxDroplets": 96,
      "bodyEffect": "drag plus buoyancy plus flowResponse*flow vector; never teleport"
    },
    "ice": {
      "heatMelts": true,
      "meltProducesWater": true,
      "coldExtinguishes": true,
      "wetTileCanFreeze": true,
      "dryObjectColdState": "visual frost and temporary low friction only; does not immobilize in air",
      "friction": 0.025,
      "timerSeconds": 8,
      "stage16PermanentFloor": true
    },
